local function DetectExecutor()
    local rawName, rawVer
    
    if identifyexecutor then
        local success, name, version = pcall(identifyexecutor)
        if success and name then
            return tostring(name) .. (version and (" " .. tostring(version)) or "")
        end
    end
    
    if getexecutorname then
        local success, name, version = pcall(getexecutorname)
        if success and name then
            return tostring(name) .. (version and (" " .. tostring(version)) or "")
        end
    end

    if Delta then return "Delta" end
    if ArceusX then return "Arceus X" end
    if Codex then return "Codex" end
    if Hydro then return "Hydrogen" end
    if Wave then return "Wave" end
    if Cryptic then return "Cryptic" end
    if VegaX then return "Vega X" end

    if syn and syn.toast_notification then return "Synapse Z" end
    if syn and syn.protect_gui then return "Synapse X" end
    if KRNL_LOADED or (krnl and krnl.loadfile) then return "Krnl" end
    if SW_LOADED or (scriptware and scriptware.loadfile) then return "Script-Ware" end
    if fluxus and fluxus.loadfile then return "Fluxus" end
    if electron and electron.loadfile then return "Electron" end
    if seliware and seliware.loadfile then return "Seliware" end
    if oxygen and oxygen.loadfile then return "Oxygen U" end
    if sirius and sirius.loadfile then return "Sirius" end
    if velocity and velocity.loadfile then return "Velocity" end
    if awp and awp.loadfile then return "AWP" end

    if isexecutor then
        local success, res = pcall(isexecutor)
        if success and res then return "Generic Executor" end
    end

    return "Unknown Executor"
end

